@model ListingsViewModel

<div class="page-header">
    <h1>What's on <small>@Model.Date.ToString("dddd d MMMM")</small></h1>
</div>

<div class="btn-group day-picker" role="group" aria-label="Choose a day">
    @foreach (var day in Model.Days)
    {
        var active = day == Model.Date ? "btn-primary" : "btn-default";
        <a class="btn @active" href="@Url.Action("Index", new { date = day.ToString("yyyy-MM-dd") })">
            @(day == Model.Days[0] ? "Today" : day.ToString("ddd d"))
        </a>
    }
</div>

@if (!Model.Movies.Any())
{
    <div class="alert alert-info">No more screenings on this day. Try another date.</div>
}

@foreach (var listing in Model.Movies)
{
    <div class="movie-card">
        <div class="row">
            <div class="col-sm-8">
                <h3>
                    <span class="rating" title="Age rating">@AgeRatingLabel(listing.Movie.Rating)</span>
                    @listing.Movie.Title
                    <small>@listing.Movie.DurationMinutes min</small>
                </h3>
                <p class="text-muted">@listing.Movie.Synopsis</p>
            </div>
            <div class="col-sm-4 text-right-sm">
                @foreach (var s in listing.Screenings)
                {
                    <a class="btn btn-default showtime" href="@Url.Action("Details", "Screenings", new { id = s.Id })">
                        @VenueTime.ToLocal(s.StartsAtUtc).ToString("HH:mm")
                        <small>@s.Hall.Name @(s.Format == ScreeningFormat.TwoD ? "" : "· " + FormatLabel(s.Format))</small>
                    </a>
                }
            </div>
        </div>
    </div>
}

@helper AgeRatingLabel(AgeRating rating)
{
    switch (rating)
    {
        case AgeRating.Twelve: @:12A
            break;
        case AgeRating.Fifteen: @:15
            break;
        case AgeRating.Eighteen: @:18
            break;
        default: @rating
            break;
    }
}

@helper FormatLabel(ScreeningFormat format)
{
    @(format == ScreeningFormat.ThreeD ? "3D" : format == ScreeningFormat.Imax ? "IMAX" : "2D")
}
