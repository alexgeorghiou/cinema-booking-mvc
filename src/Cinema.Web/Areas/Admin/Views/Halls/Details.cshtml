@model Hall

<h2>@Model.Name <small>@Model.Capacity seats</small></h2>
<div class="screen-label">SCREEN</div>
<div class="screen"></div>
<div class="seat-map">
    @foreach (var row in Model.Rows())
    {
        <div class="seat-row">
            <span class="seat-row-label">@row.Key</span>
            @foreach (var seat in row)
            {
                <span class="seat seat-available seat-@seat.Type.ToString().ToLowerInvariant()" title="@seat.Label">@seat.Number</span>
            }
        </div>
    }
</div>
