@model IReadOnlyList<Movie>

<h2>Movies <a class="btn btn-primary btn-sm pull-right" href="@Url.Action("Create")">Add movie</a></h2>
<table class="table table-striped">
    <thead><tr><th>Title</th><th>Rating</th><th>Duration</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr class="@(m.IsActive ? "" : "text-muted")">
                <td>@m.Title</td>
                <td>@DisplayLabels.Rating(m.Rating)</td>
                <td>@m.DurationMinutes min</td>
                <td>@(m.IsActive ? "Active" : "Archived")</td>
                <td class="text-right">
                    @Html.ActionLink("Edit", "Edit", new { id = m.Id }, new { @class = "btn btn-default btn-xs" })
                    @using (Html.BeginForm("ToggleActive", "Movies", new { id = m.Id }, FormMethod.Post, new { style = "display:inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link btn-xs">@(m.IsActive ? "Archive" : "Restore")</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
