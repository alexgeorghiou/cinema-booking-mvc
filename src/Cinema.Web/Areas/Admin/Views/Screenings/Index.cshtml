@model IReadOnlyList<Screening>

<h2>Screenings <small>next 14 days</small>
    <a class="btn btn-primary btn-sm pull-right" href="@Url.Action("Create")">Schedule screening</a></h2>
<table class="table table-striped table-condensed">
    <thead><tr><th>Start</th><th>Film</th><th>Hall</th><th>Format</th><th class="text-right">Base price</th><th></th></tr></thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@Html.LocalTime(s.StartsAtUtc)</td>
                <td>@s.Movie.Title</td>
                <td>@s.Hall.Name</td>
                <td>@DisplayLabels.Format(s.Format)</td>
                <td class="text-right">@Html.Money(s.BasePrice)</td>
                <td class="text-right">@Html.ActionLink("Bookings", "Bookings", new { id = s.Id }, new { @class = "btn btn-default btn-xs" })</td>
            </tr>
        }
    </tbody>
</table>
