@model ScreeningForm

<h2>Schedule screening</h2>
<p class="text-muted">The hall must be free for the film's running time plus the cleaning buffer.</p>
@using (Html.BeginForm("Create", "Screenings", FormMethod.Post, new { @class = "form-horizontal" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="form-group">
        @Html.LabelFor(m => m.MovieId, new { @class = "col-sm-3 control-label" })
        <div class="col-sm-6">@Html.DropDownListFor(m => m.MovieId, Model.Movies, "Choose a film", new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.HallId, new { @class = "col-sm-3 control-label" })
        <div class="col-sm-6">@Html.DropDownListFor(m => m.HallId, Model.Halls, "Choose a hall", new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.StartsAtLocal, new { @class = "col-sm-3 control-label" })
        <div class="col-sm-4">
            @Html.TextBoxFor(m => m.StartsAtLocal, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local" })
            @Html.ValidationMessageFor(m => m.StartsAtLocal, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.BasePrice, new { @class = "col-sm-3 control-label" })
        <div class="col-sm-2">
            @Html.TextBoxFor(m => m.BasePrice, "{0:0.00}", new { @class = "form-control", type = "number", step = "0.05" })
            @Html.ValidationMessageFor(m => m.BasePrice, "", new { @class = "text-danger" })
        </div>
        @Html.LabelFor(m => m.Format, new { @class = "col-sm-1 control-label" })
        <div class="col-sm-3">@Html.EnumDropDownListFor(m => m.Format, new { @class = "form-control" })</div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-3 col-sm-9"><button type="submit" class="btn btn-primary">Schedule</button></div>
    </div>
}
